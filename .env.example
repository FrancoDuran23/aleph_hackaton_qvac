# --- Anthropic (chat, parsing de queries, generación de respuestas) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Gemini (embeddings + descomposición multihop) ---
GEMINI_API_KEY=...

# --- WhatsApp via WASenderApi (https://wasenderapi.com) ---
WASENDER_API_TOKEN=
WASENDER_SESSION_ID=

# --- Postgres (levantado por docker-compose, no tocar en local) ---
DATABASE_URL=postgresql://hackaton:hackaton@postgres:5432/hackaton

PORT=8000

# --- QVAC (inferencia local, reemplaza Anthropic + Gemini) ---
# Requiere el bridge levantado y el túnel SSH abierto.
# Apunta a un endpoint de inferencia QVAC accesible desde la app.
QVAC_BRIDGE_URL=http://127.0.0.1:8081
QVAC_BRIDGE_TOKEN=
QVAC_LLM_MODEL=QWEN3_1_7B_INST_Q4
QVAC_EMBED_MODEL=EMBEDDINGGEMMA_300M_Q4_0
QVAC_BRIDGE_TIMEOUT=600
